{
  "name": "ai-job-portal",
  "version": "1.0.0",
  "description": "AI-Powered Advanced Job Portal",
  "scripts": {
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:admin",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:admin": "cd admin-panel && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:admin": "cd admin-panel && npm run dev",
    "dev:ai": "cd ai-service && .\\venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ai\" \"npm run dev:admin\""
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "netlify-cli": "^26.0.2"
  }
}
